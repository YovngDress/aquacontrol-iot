# Copy this file to .env and fill in real values. Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=aquacontrol
POSTGRES_USER=aquacontrol
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# DB_ENGINE=sqlite para correr sin PostgreSQL (ej. directo en la Raspberry Pi sin Docker)
DB_ENGINE=postgres

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Bootstraps un usuario admin (rol Global) en el primer `migrate` (ver backend/Dockerfile / docker-compose.yml)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-admin-password

# --- MQTT / Mosquitto ---
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USERNAME=planta
MQTT_PASSWORD=change-me-mqtt-password
MQTT_TOPIC_PREFIX=planta

# --- Puertos publicados en el host (útiles si ya tienes otro proyecto usando
# los puertos por defecto 8000/1883 en esta misma máquina) ---
WEB_HOST_PORT=8000
MOSQUITTO_HOST_PORT=1883

# --- Simulador del ESP32 (servicio "simulator"). El token lo imprime
# `docker compose exec web python manage.py seed_demo_data`.
# Los tokens del PLC y de la Raspberry Pi van en Node-RED (ver nodered/README.md).
SIMULATOR_DEVICE_TOKENS=esp32-calidad-01:paste-token-here

# --- Google Maps (geolocalización de dispositivos e instalaciones) ---
# Deja vacío para desarrollar sin mapa (se muestra un aviso en su lugar).
# Ver README.md > "Geolocalización" para cómo generar una key.
GOOGLE_MAPS_API_KEY=
